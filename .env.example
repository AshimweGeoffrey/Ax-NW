# Copy to .env (root) for docker compose, and to backend/.env for local (non-docker) dev
DB_ROOT_PASSWORD=axroot
DB_NAME=AX_STOCK_ALX_PROJECT1
DB_PORT=3307
# Local dev (backend/.env) only:
DATABASE_URL="mysql://root:axroot@127.0.0.1:3307/AX_STOCK_ALX_PROJECT1"
# REQUIRED outside docker; generate with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
API_VERSION=v1
APP_TZ=Africa/Kigali
DB_TZ_OFFSET=+02:00
